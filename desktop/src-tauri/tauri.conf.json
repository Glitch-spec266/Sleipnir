{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sleipnir",
  "version": "0.1.0",
  "identifier": "dev.sleipnir.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:4174",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sleipnir",
        "width": 1440,
        "height": 960,
        "minWidth": 960,
        "minHeight": 680,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Desktop control surface for Sleipnir",
    "longDescription": "A local-first operator workbench for autonomous multi-model projects.",
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
